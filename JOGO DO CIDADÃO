import React, { useState } from 'react';
import { User, Heart, Scale, TrendingUp, Award, ArrowRight, RefreshCw } from 'lucide-react';

const GAME_STATES = {
  START: 'start',
  PLAYING: 'playing',
  FEEDBACK: 'feedback',
  ENDED: 'ended',
};

const INITIAL_STATS = {
  honestidade: 50,
  civismo: 50,
  bemEstar: 50, // Representa dinheiro/conforto/popularidade imediata
};

// Cenários do jogo
const SCENARIOS = [
  {
    id: 1,
    title: "O Troco Extra",
    description: "Você foi à padaria comprar pão. Ao chegar em casa, percebeu que o caixa lhe deu 10€ a mais de troco por engano.",
    choices: [
      {
        text: "Ficar com o dinheiro. Erro deles.",
        impact: { honestidade: -20, civismo: -5, bemEstar: 15 },
        feedback: "Você ganhou dinheiro fácil, mas sentiu um peso na consciência. A padaria terá prejuízo hoje."
      },
      {
        text: "Voltar à padaria e devolver o dinheiro.",
        impact: { honestidade: 25, civismo: 10, bemEstar: -5 },
        feedback: "O caixa ficou muito grato e aliviado. Você perdeu tempo, mas fez a coisa certa."
      }
    ]
  },
  {
    id: 2,
    title: "O Teste Difícil",
    description: "Amanhã é o teste final de História. Você não estudou o suficiente. Um amigo conseguiu as respostas e oferece-lhas.",
    choices: [
      {
        text: "Aceitar as respostas e garantir uma boa nota.",
        impact: { honestidade: -30, civismo: -10, bemEstar: 20 },
        feedback: "Você tirou nota máxima, mas não aprendeu nada e prejudicou quem estudou de verdade."
      },
      {
        text: "Recusar e passar a noite a estudar o máximo possível.",
        impact: { honestidade: 20, civismo: 5, bemEstar: -15 },
        feedback: "Foi cansativo e a nota não foi perfeita, mas o mérito é todo seu."
      }
    ]
  },
  {
    id: 3,
    title: "O Parque Local",
    description: "Você está no parque com amigos. Não há caixotes do lixo por perto e vocês terminaram os vossos lanches.",
    choices: [
      {
        text: "Deixar o lixo num canto discreto. Alguém limpa depois.",
        impact: { honestidade: -5, civismo: -25, bemEstar: 5 },
        feedback: "O parque ficou mais sujo. Se todos fizerem isso, o espaço torna-se inutilizável."
      },
      {
        text: "Guardar o lixo na mochila até encontrar um caixote.",
        impact: { honestidade: 5, civismo: 20, bemEstar: -5 },
        feedback: "Foi um pequeno incómodo, mas você ajudou a manter o espaço público limpo para todos."
      }
    ]
  },
  {
    id: 4,
    title: "O Semáforo Avariado",
    description: "É tarde da noite, não há ninguém na rua e o semáforo para peões está vermelho e parece não mudar.",
    choices: [
      {
        text: "Atravessar mesmo assim. Não há perigo.",
        impact: { honestidade: 0, civismo: -15, bemEstar: 10 },
        feedback: "Você chegou mais rápido, mas desrespeitou uma regra de trânsito básica."
      },
      {
        text: "Esperar até que fique verde ou procurar outra passadeira.",
        impact: { honestidade: 5, civismo: 15, bemEstar: -10 },
        feedback: "Você demonstrou paciência e respeito pelas leis, mesmo quando ninguém estava a ver."
      }
    ]
  },
  {
    id: 5,
    title: "Voto na Escola",
    description: "Há eleições para representante de turma. O seu melhor amigo está a candidatar-se, mas não tem boas propostas. O outro candidato é mais preparado.",
    choices: [
      {
        text: "Votar no amigo só pela amizade.",
        impact: { honestidade: -10, civismo: -20, bemEstar: 15 },
        feedback: "O seu amigo ficou feliz, mas a turma terá uma liderança fraca este ano."
      },
      {
        text: "Votar no candidato mais preparado.",
        impact: { honestidade: 15, civismo: 25, bemEstar: -5 },
        feedback: "Foi uma decisão difícil que pode chatear o seu amigo, mas você pensou no coletivo."
      }
    ]
  }
];

function App() {
  const [gameState, setGameState] = useState(GAME_STATES.START);
  const [currentScenarioIndex, setCurrentScenarioIndex] = useState(0);
  const [stats, setStats] = useState(INITIAL_STATS);
  const [lastFeedback, setLastFeedback] = useState("");
  const [scoreImpact, setScoreImpact] = useState(null);

  const startGame = () => {
    setStats(INITIAL_STATS);
    setCurrentScenarioIndex(0);
    setGameState(GAME_STATES.PLAYING);
  };

  const handleChoice = (choice) => {
    const newStats = { ...stats };
    newStats.honestidade = Math.max(0, Math.min(100, newStats.honestidade + choice.impact.honestidade));
    newStats.civismo = Math.max(0, Math.min(100, newStats.civismo + choice.impact.civismo));
    newStats.bemEstar = Math.max(0, Math.min(100, newStats.bemEstar + choice.impact.bemEstar));
    
    setStats(newStats);
    setLastFeedback(choice.feedback);
    setScoreImpact(choice.impact);
    setGameState(GAME_STATES.FEEDBACK);
  };

  const nextScenario = () => {
    if (currentScenarioIndex < SCENARIOS.length - 1) {
      setCurrentScenarioIndex(currentScenarioIndex + 1);
      setGameState(GAME_STATES.PLAYING);
    } else {
      setGameState(GAME_STATES.ENDED);
    }
  };

  const getFinalResult = () => {
    const avg = (stats.honestidade + stats.civismo) / 2;
    if (avg >= 80) return { title: "Cidadão Exemplar!", color: "text-green-600", msg: "Você entende que um país melhor começa com as suas atitudes diárias. Parabéns!" };
    if (avg >= 50) return { title: "Cidadão em Desenvolvimento", color: "text-yellow-600", msg: "Você está no caminho certo, mas às vezes deixa o conforto pessoal falar mais alto que o dever coletivo." };
    return { title: "Precisa Repensar", color: "text-red-600", msg: "As suas escolhas priorizaram muito o ganho imediato. Um país feito de pessoas assim terá muitas dificuldades." };
  };

  // Componentes de UI
  const StatBar = ({ icon: Icon, label, value, color, impact }) => (
    <div className="mb-4">
      <div className="flex justify-between items-center mb-1">
        <div className="flex items-center gap-2 text-gray-700 font-semibold">
          <Icon size={18} />
          <span>{label}</span>
        </div>
        <div className="flex items-center">
           <span className="text-sm font-bold mr-2">{value}%</span>
           {impact !== 0 && gameState === GAME_STATES.FEEDBACK && (
             <span className={`text-xs font-bold ${impact > 0 ? 'text-green-500' : 'text-red-500'} animate-pulse`}>
               {impact > 0 ? '+' : ''}{impact}
             </span>
           )}
        </div>
      </div>
      <div className="h-3 w-full bg-gray-200 rounded-full overflow-hidden">
        <div 
          className={`h-full ${color} transition-all duration-700 ease-out`}
          style={{ width: `${value}%` }}
        />
      </div>
    </div>
  );

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 font-['Inter'] p-4 flex items-center justify-center">
      <div className="bg-white rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden">
        
        {/* Header com Stats (sempre visível durante o jogo) */}
        {gameState !== GAME_STATES.START && (
          <div className="bg-slate-800 p-4 text-white">
            <div className="grid grid-cols-3 gap-4">
              <StatBar icon={Scale} label="Honestidade" value={stats.honestidade} color="bg-blue-500" impact={scoreImpact?.honestidade || 0} />
              <StatBar icon={User} label="Civismo" value={stats.civismo} color="bg-green-500" impact={scoreImpact?.civismo || 0} />
              <StatBar icon={Heart} label="Bem-Estar Pessoal" value={stats.bemEstar} color="bg-yellow-500" impact={scoreImpact?.bemEstar || 0} />
            </div>
          </div>
        )}

        <div className="p-6 md:p-8">
          {/* TELA INICIAL */}
          {gameState === GAME_STATES.START && (
            <div className="text-center space-y-6 py-8">
              <div className="bg-blue-100 w-24 h-24 rounded-full flex items-center justify-center mx-auto mb-6">
                <Award size={48} className="text-blue-600" />
              </div>
              <h1 className="text-4xl font-bold text-gray-800 mb-2">Jornada da Cidadania</h1>
              <p className="text-gray-600 text-lg max-w-md mx-auto">
                As suas escolhas diárias definem o país em que vivemos. Você está pronto para testar a sua integridade?
              </p>
              <button 
                onClick={startGame}
                className="bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-xl transition-all transform hover:scale-105 flex items-center gap-2 mx-auto"
              >
                Começar a Jornada <ArrowRight size={20} />
              </button>
            </div>
          )}

          {/* TELA DE JOGO */}
          {gameState === GAME_STATES.PLAYING && (
            <div className="animate-fade-in">
              <div className="flex justify-between items-center text-sm text-gray-500 mb-4">
                <span>Cenário {currentScenarioIndex + 1} de {SCENARIOS.length}</span>
              </div>
              <h2 className="text-2xl font-bold text-gray-800 mb-4">{SCENARIOS[currentScenarioIndex].title}</h2>
              <p className="text-lg text-gray-700 mb-8 leading-relaxed bg-gray-50 p-4 rounded-lg border-l-4 border-blue-500">
                {SCENARIOS[currentScenarioIndex].description}
              </p>

              <div className="space-y-4">
                {SCENARIOS[currentScenarioIndex].choices.map((choice, idx) => (
                  <button
                    key={idx}
                    onClick={() => handleChoice(choice)}
                    className="w-full text-left p-4 rounded-xl border-2 border-gray-200 hover:border-blue-500 hover:bg-blue-50 transition-all group"
                  >
                    <span className="font-semibold text-gray-800 group-hover:text-blue-700">{choice.text}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* TELA DE FEEDBACK */}
          {gameState === GAME_STATES.FEEDBACK && (
            <div className="text-center py-6 animate-fade-in">
              <h3 className="text-2xl font-bold text-gray-800 mb-4">Consequência</h3>
              <div className="bg-gray-100 p-6 rounded-xl mb-8 text-lg text-gray-700">
                {lastFeedback}
              </div>
              <button 
                onClick={nextScenario}
                className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-xl transition-all flex items-center gap-2 mx-auto"
              >
                Continuar <ArrowRight size={20} />
              </button>
            </div>
          )}

          {/* TELA FINAL */}
          {gameState === GAME_STATES.ENDED && (
            <div className="text-center py-6 animate-fade-in">
              <Award size={64} className={`mx-auto mb-4 ${getFinalResult().color}`} />
              <h2 className={`text-3xl font-bold mb-2 ${getFinalResult().color}`}>
                {getFinalResult().title}
              </h2>
              <p className="text-xl text-gray-600 mb-8 max-w-md mx-auto">
                {getFinalResult().msg}
              </p>
              
              <div className="bg-slate-50 p-6 rounded-xl text-left mb-8">
                <h4 className="font-bold text-gray-800 mb-2 flex items-center gap-2">
                  <TrendingUp size={20} />
                  Lição Final:
                </h4>
                <p className="text-gray-700">
                  Ser um cidadão útil e honesto muitas vezes exige sacrifícios pessoais imediatos (como perder tempo ou dinheiro). 
                  No entanto, é essa integridade que constrói a confiança entre as pessoas e faz o país prosperar para todos a longo prazo.
                </p>
              </div>

              <button 
                onClick={startGame}
                className="bg-gray-800 hover:bg-gray-900 text-white font-bold py-3 px-8 rounded-xl transition-all flex items-center gap-2 mx-auto"
              >
                Jogar Novamente <RefreshCw size={18} />
              </button>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

export default App;
